
class Solution {
public:
    vector<vector<int>> subsets(vector<int>& nums) {
        vector<vector<int>> ans;
        vector<int> path;

        function<void(int)> solve = [&](int index) {
            if (index == nums.size()) {
                ans.push_back(path);
                return;
            }

            // Include current element
            path.push_back(nums[index]);
            solve(index + 1);

            // Exclude current element
            path.pop_back();
            solve(index + 1);
        };

        solve(0);
        return ans;
    }
};
