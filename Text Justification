class Solution {
public:
    vector<string> fullJustify(vector<string>& words, int maxWidth) {
        vector<string> ans;
        int i = 0;
        int n = words.size();

        while (i < n) {
            int j = i;
            int len = 0;

            // Find words that can fit in this line
            while (j < n && len + words[j].size() + (j - i) <= maxWidth) {
                len += words[j].size();
                j++;
            }

            int spaces = maxWidth - len;
            int count = j - i;

            string line = "";

            // Last line OR only one word
            if (j == n || count == 1) {
                for (int k = i; k < j; k++) {
                    line += words[k];

                    if (k != j - 1)
                        line += " ";
                }

                // Add remaining spaces at the end
                line += string(maxWidth - line.size(), ' ');
            }
            else {
                // Distribute spaces between words
                int gaps = count - 1;
                int eachSpace = spaces / gaps;
                int extra = spaces % gaps;

                for (int k = i; k < j; k++) {
                    line += words[k];

                    if (k != j - 1) {
                        line += string(eachSpace + (extra > 0 ? 1 : 0), ' ');

                        if (extra > 0)
                            extra--;
                    }
                }
            }

            ans.push_back(line);
            i = j;
        }

        return ans;
    }
};
