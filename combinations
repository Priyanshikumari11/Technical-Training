
class Solution {
public:
    vector<vector<int>> combine(int n, int k) {
        vector<vector<int>> ans;
        vector<int> path;

        function<void(int)> solve = [&](int start) {
            if (path.size() == k) {
                ans.push_back(path);
                return;
            }

            for (int i = start; i <= n; i++) {
                path.push_back(i);
                solve(i + 1);
                path.pop_back();
            }
        };

        solve(1);
        return ans;
    }
};
